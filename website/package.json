{
  "name": "snowy-desktop",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
